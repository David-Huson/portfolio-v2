---
const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="footer">
    <p>© {year} David Huson<br /><span>Fort Worth, Texas</span></p><nav
      aria-label="Elsewhere"
    >
      <a href="mailto:dhuson@davidhuson.dev">Email</a><a
        href="https://www.linkedin.com/in/david-huson">LinkedIn ↗</a
      ><a href="/writing/">Writing</a><a href="https://davidhuson.dev"
        >Consulting ↗</a>
    </nav>
  </div>
</footer>
<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .footer span {
    font-size: 0.75rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: start;
  }
  nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  @media (max-width: 639px) {
    .footer {
      display: block;
    }
    nav {
      margin-top: 1rem;
    }
  }
</style>
