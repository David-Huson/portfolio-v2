---
const links = [
  { href: "/projects/", label: "Work" },
  { href: "/about/", label: "About" },
  { href: "https://github.com/David-Huson", label: "GitHub ↗" },
];
---

<header class="wrap">
  <div class="navigation">
    <a class="identity" href="/" aria-label="David Huson, home">David Huson</a
    ><nav aria-label="Main navigation">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={Astro.url.pathname === href ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<style>
  .navigation {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
    min-height: 104px;
    border-bottom: 1px solid var(--line);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .identity {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.875rem;
  }
  a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  @media (max-width: 639px) {
    .navigation {
      display: block;
      padding: 1rem 0;
    }
    .identity {
      min-height: 36px;
    }
    nav {
      gap: 1.75rem;
    }
  }
</style>
