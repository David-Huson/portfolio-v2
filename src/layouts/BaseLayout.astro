---
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head><MainHead {...Astro.props} /></head><body
    ><a class="skip" href="#main">Skip to content</a><Nav /><main
      id="main"
      class="wrap main"
    >
      <slot />
    </main><Footer /></body
  >
</html>
