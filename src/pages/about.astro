---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Pill from '../components/Pill.astro';
---

<BaseLayout title="About | David Huson" description="About David Huson, Lead Software Engineer building healthcare data platforms in Fort Worth, Texas">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/about-hero.webp"
					alt="David Huson taking a selfie with a companion in front of a colorful mural of a black horse, ocean waves, and wildlife"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm a Lead Software Engineer at a healthcare company in Fort Worth, Texas, where I build
						HIPAA-compliant data platforms: event-driven pipelines on AWS (Lambda, SQS, ECS),
						long-running services in Kotlin, and PostgreSQL/Supabase warehousing modeled with
						Kimball star schemas. The common thread in my work is taking manual, error-prone data
						processes and turning them into automated systems that are auditable and recover
						cleanly from failure.
					</p>
					<br />
					<p>
						Outside of software, I'm passionate about cooking and sharing good food with the people
						I love, and I play video games when I can find the time. I spend a lot of time (maybe
						too much) watching educational YouTube videos, and I enjoy passing knowledge along —
						when someone on my team hits a wall, I'd rather debug it with them and talk through how
						to avoid it next time than just hand over a fix.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<h5>University of West Florida</h5>
					<p>B.S. in Computer Science, with a concentration in Artificial Intelligence and Software Engineering.</p>
					<br />
					<p>
						Some of the coursework from that time still lives in the
						<a target="_self" href="/projects/">projects archive</a> on this site — a C++
						Minesweeper, a recursive descent parser in C, and an image classifier built with
						TensorFlow and Keras, among others.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="skills">
					<Pill>Kotlin</Pill>
					<Pill>AWS (Lambda, SQS, ECS)</Pill>
					<Pill>PostgreSQL / Supabase</Pill>
					<Pill>Dimensional Modeling</Pill>
					<Pill>HIPAA Compliance</Pill>
					<Pill>Event-Driven Architecture</Pill>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
