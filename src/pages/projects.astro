---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const current = projects.filter((project) => !project.data.archived);
const archive = projects.filter((project) => project.data.archived);
---

<BaseLayout
  title="Work | David Huson"
  description="David Huson's engineering work: healthcare data platforms, systems thinking, and detailed accounts of earlier software projects."
>
  <header class="page-head">
    <p class="kicker">Work & decisions</p><h1>
      The reasoning behind the implementation.
    </h1><p class="lead">
      My current work is in healthcare data platforms. The studies below
      document earlier projects, including the choices I would revisit.
    </p>
  </header><section class="section scope" aria-labelledby="practice-title">
    <p class="kicker">Professional scope</p><div class="scope-copy">
      <h2 id="practice-title">From ingestion to analytical models.</h2><p>
        I work with event-driven pipelines on AWS, long-running Kotlin services,
        and PostgreSQL/Supabase warehouses using Kimball star schemas.
        Reliability, access control and recovery are part of the architecture.
      </p><a class="action" href="/about/"
        >About my current work <span aria-hidden="true">↗</span></a>
    </div>
  </section>{
    current.length > 0 && (
      <section class="section" aria-labelledby="current-projects">
        <>
          <h2 id="current-projects">Selected work</h2>
          <ul class="story-list">
            {current.map((project) => (
              <li>
                <ProjectPreview project={project} />
              </li>
            ))}
          </ul>
        </>
      </section>
    )
  }<section class="section" aria-labelledby="archive-title">
    <header class="section-head">
      <h2 id="archive-title">Earlier work</h2><p>
        Course projects in language design, algorithms and machine learning.
        Each account includes its context and limitations.
      </p>
    </header><ul class="story-list">
      {
        archive.map((project) => (
          <li>
            <ProjectPreview project={project} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
