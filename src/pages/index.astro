---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
const projects = await getCollection("projects");
const featured = projects.find(
  (project) => project.slug === "healthcare-operations",
);
const selected = projects.filter((project) =>
  ["healthcare-data-foundation", "recursive-descent-parser"].includes(
    project.slug,
  ),
);
---

<BaseLayout>
  <section class="journal-hero">
    <aside class="folio" aria-label="Professional profile">
      <span>David Huson</span><p>
        Lead Software Engineer<br />Fort Worth, Texas
      </p>
    </aside><div>
      <p class="kicker">Software / Data / Systems</p><h1>
        Software, with a clear line of reasoning.
      </h1><p class="lead">
        I build healthcare data platforms. This is a record of the systems,
        decisions, and tradeoffs behind my work.
      </p><a class="action" href="#work"
        >Explore the work <span aria-hidden="true">↓</span></a
      >
    </div>
  </section><section class="section" id="work" aria-labelledby="work-title">
    <header class="section-head">
      <h2 id="work-title">Selected studies</h2><p>
        Live healthcare workflows, a data foundation in progress, and earlier
        work.
      </p>
    </header>{
      featured && (
        <article class="feature">
          <div>
            <>
              <p class="meta">National Breathe Free · Live platform</p>
              <h3 class="feature-title">
                Making healthcare operations easier to coordinate.
              </h3>
              <p class="lead">
                An internal platform serving 50+ clinics and 300+ total users. I
                led the design, across enrichment and insurance verification
                workflows.
              </p>
              <a class="action" href={`/projects/${featured.slug}/`}>
                Read the case study <span aria-hidden="true">↗</span>
              </a>
            </>
          </div>
          {featured.data.diagram && (
            <SystemDiagram diagram={featured.data.diagram} />
          )}
        </article>
      )
    }<ul class="story-list">
      {
        selected.map((project) => (
          <li>
            <ProjectPreview project={project} />
          </li>
        ))
      }
    </ul><a class="action" href="/projects/"
      >All work <span aria-hidden="true">↗</span></a
    >
  </section><section class="section scope" aria-labelledby="current-title">
    <p class="kicker">Current practice</p><div class="scope-copy">
      <h2 id="current-title">Data systems that can recover.</h2><p>
        I joined National Breathe Free in May 2024, straight out of college. I
        designed nearly the entire internal platform, with direction from our
        CTO and development support from another engineer.
      </p><p>
        Scaling the ETL pipeline has been the hardest part. If I were starting
        again, I would begin with ingestion and spend more time on the data
        model before building the frontend.
      </p><a class="action" href="/about/"
        >More about my work and background <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
</BaseLayout>
<style>
  .feature-title {
    font-size: clamp(2rem, 1.25rem + 2vw, 3.25rem);
    margin: 1.25rem 0;
    max-width: 18ch;
  }
</style>
