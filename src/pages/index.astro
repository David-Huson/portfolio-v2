---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
const projects = await getCollection("projects");
const parser = projects.find(
  (project) => project.slug === "recursive-descent-parser",
);
const selected = projects.filter((project) =>
  ["image-classifier", "python-lisp-fsa"].includes(project.slug),
);
---

<BaseLayout>
  <section class="journal-hero">
    <aside class="folio" aria-label="Professional profile">
      <span>David Huson</span><p>
        Lead Software Engineer<br />Fort Worth, Texas
      </p>
    </aside><div>
      <p class="kicker">Software / Data / Systems</p><h1>
        Software, with a clear line of reasoning.
      </h1><p class="lead">
        I build healthcare data platforms. This is a record of the systems,
        decisions, and tradeoffs behind my work.
      </p><a class="action" href="#work"
        >Explore the work <span aria-hidden="true">↓</span></a>
    </div>
  </section><section class="section" id="work" aria-labelledby="work-title">
    <header class="section-head">
      <h2 id="work-title">Selected studies</h2><p>
        Earlier projects, with the decisions and limitations left in.
      </p>
    </header>{
      parser && (
        <article class="feature">
          <div>
            <>
              <p class="meta">Earlier work · Language design · C</p>
              <h3 class="feature-title">
                When the grammar becomes the program.
              </h3>
              <p class="lead">
                A small compiler front end. One function per grammar rule, with
                explicit choices about memory, errors and scope.
              </p>
              <a class="action" href={`/projects/${parser.slug}/`}>
                Read the case study <span aria-hidden="true">↗</span>
              </a>
            </>
          </div>
          {parser.data.diagram && (
            <SystemDiagram diagram={parser.data.diagram} />
          )}
        </article>
      )
    }<ul class="story-list">
      {
        selected.map((project) => (
          <li>
            <ProjectPreview project={project} />
          </li>
        ))
      }
    </ul><a class="action" href="/projects/"
      >All work <span aria-hidden="true">↗</span></a>
  </section><section class="section scope" aria-labelledby="current-title">
    <p class="kicker">Current practice</p><div class="scope-copy">
      <h2 id="current-title">Data systems that can recover.</h2><p>
        I lead data platform work at a healthcare company. That includes
        event-driven ingestion on AWS, long-running Kotlin services, and
        PostgreSQL/Supabase warehouses built around Kimball star schemas.
      </p><p>
        Much of that work replaces manual, error-prone processes with systems
        that can be audited and recover cleanly from failure. Access control and
        operational reliability shape the design from the start.
      </p><a class="action" href="/about/"
        >More about my work and background <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
<style>
  .feature-title {
    font-size: clamp(2rem, 1.25rem + 2vw, 3.25rem);
    margin: 1.25rem 0;
    max-width: 18ch;
  }
</style>
